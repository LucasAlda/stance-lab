{
  "name": "stance-lab",
  "version": "1.0.0",
  "description": "Wii Balance Board acquisition and golf force dashboard",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n service,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0 --port 3000\"",
    "dev:service": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && python3 -m unittest discover -s python -p \"test_*.py\"",
    "test:production": "node scripts/smoke-production.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
